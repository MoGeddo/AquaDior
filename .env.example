# ============================================================
#  انسخ الملف ده لـ .env  وحط قيمك
#  cp .env.example .env
# ============================================================

# ============ Supabase ============
# من: Project Settings → API Keys → Publishable key
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# OneSignal App ID is public client config (not a secret). Keep the REST API key server-side.
VITE_ONESIGNAL_APP_ID=YOUR-ONESIGNAL-APP-ID

# حسابات الإدارة تُنشأ وتُدار في Supabase Auth؛ لا تضع كلمات مرور في متغيرات VITE_
# ============ وضع التشغيل ============
VITE_DEMO_MODE=0
# للتجربة المحلية فقط، غيّرها إلى 1 يدويًا. لا ترفعها إلى بيئة حقيقية.
